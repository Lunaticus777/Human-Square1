    <button class="lm-lightbox-nav lm-lightbox-prev" onclick="event.stopPropagation();navLb(-1)">‹</button>
    <img id="lm-lb-img" src="" alt="" />
    <button class="lm-lightbox-nav lm-lightbox-next" onclick="event.stopPropagation();navLb(1)">›</button>
    <div class="lm-lightbox-counter" id="lm-lb-counter"></div>
</div>

<script>
    const lmImages = [
        '/images/lomba-01.png',
        '/images/lomba-02.jpeg',
        '/images/DJI_20260326140655_0581_D.JPG',
        '/images/DJI_20260326140724_0585_D.JPG'
    ];
    let lmCurrent = 0;

    function openLb(idx) {
        lmCurrent = idx;
        document.getElementById('lm-lb-img').src = lmImages[lmCurrent];
        document.getElementById('lm-lb-counter').textContent = (lmCurrent+1) + ' / ' + lmImages.length;
        document.getElementById('lm-lb').classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeLb(e) {
        if (!e || e.target === document.getElementById('lm-lb')) {
            document.getElementById('lm-lb').classList.remove('open');
            document.body.style.overflow = '';
        }
    }

    function navLb(dir) {
        lmCurrent = (lmCurrent + dir + lmImages.length) % lmImages.length;
        document.getElementById('lm-lb-img').src = lmImages[lmCurrent];
        document.getElementById('lm-lb-counter').textContent = (lmCurrent+1) + ' / ' + lmImages.length;
    }

    document.addEventListener('keydown', e => {
        if (document.getElementById('lm-lb').classList.contains('open')) {
            if (e.key === 'ArrowRight') navLb(1);
            if (e.key === 'ArrowLeft') navLb(-1);
            if (e.key === 'Escape') closeLb({ target: document.getElementById('lm-lb') });
        }
    });
</script>
