@{
    ViewData["Title"] = "Projet Touristique Lomba – Gondomar | Human Square";
    ViewData["Description"] = "Terrain avec PIP approuve – Complexe touristique 16 unites + restaurant panoramique au bord du Douro, Gondomar. 690 000 EUR. Human Square Portugal.";
}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet" />

<style>
    :root {
        --ink: #0c0c0a;
        --cream: #f5f3ee;
        --warm: #ece8df;
        --gold: #b8935a;
        --gold2: #d4b483;
        --muted: #78766e;
        --hint: #aeac9f;
        --border: rgba(12,12,10,0.09);
        --forest: #2d4a2d;
        --forest2: #3a5c3a;
    }

    .lm {
        font-family: 'Cormorant Garamond',Georgia,serif;
        background: var(--cream);
        color: var(--ink);
        overflow-x: hidden;
    }

    /* ── GALERIE HERO ── */
    .lm-gallery {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 480px 300px;
        gap: 3px;
        background: var(--ink);
        height: 780px;
    }

    .lm-gallery-main {
        grid-row: 1/3;
        overflow: hidden;
        position: relative;
        cursor: pointer;
    }

        .lm-gallery-main img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .6s cubic-bezier(.22,1,.36,1);
        }

        .lm-gallery-main:hover img {
            transform: scale(1.03);
        }

    .lm-gallery-thumb {
        overflow: hidden;
        position: relative;
        cursor: pointer;
    }

        .lm-gallery-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .5s;
        }

        .lm-gallery-thumb:hover img {
            transform: scale(1.06);
        }

    .lm-pip-badge {
        position: absolute;
        top: 24px;
        left: 24px;
        font-family: 'DM Mono',monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #fff;
        background: var(--forest);
        padding: 7px 16px;
        z-index: 10;
        border: 0.5px solid rgba(255,255,255,.15);
    }

    .lm-gallery-count {
        position: absolute;
        bottom: 18px;
        right: 18px;
        font-family: 'DM Mono',monospace;
        font-size: 9px;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: #fff;
        background: rgba(12,12,10,.55);
        border: 0.5px solid rgba(255,255,255,.2);
        padding: 8px 16px;
        cursor: pointer;
        backdrop-filter: blur(4px);
        z-index: 10;
        transition: background .2s;
    }

        .lm-gallery-count:hover {
            background: rgba(12,12,10,.8);
        }

    /* ── HEADER ── */
    .lm-header {
        background: var(--cream);
        padding: 52px 0 0;
        border-bottom: 0.5px solid var(--border);
    }

    .lm-header-grid {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 48px;
        align-items: start;
        padding-bottom: 36px;
        border-bottom: 0.5px solid var(--border);
        margin-bottom: 28px;
    }

    .lm-pretitle {
        font-family: 'DM Mono',monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: .22em;
        text-transform: uppercase;
        color: var(--forest);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .lm-pretitle::before {
            content: '';
            width: 20px;
            height: 1px;
            background: var(--forest);
            display: block;
        }

    .lm-h1 {
        font-size: clamp(36px,4.5vw,62px);
        font-weight: 300;
        line-height: .96;
        color: var(--ink);
        margin-bottom: 12px;
        letter-spacing: -.02em;
    }

        .lm-h1 em {
            font-style: italic;
            color: var(--muted);
            display: block;
        }

    .lm-loc {
        font-family: 'DM Mono',monospace;
        font-size: 11px;
        font-weight: 300;
        color: var(--hint);
        letter-spacing: .08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .lm-prix-bloc {
        text-align: right;
    }

    .lm-prix {
        font-size: clamp(32px,3.5vw,50px);
        font-weight: 300;
        color: var(--ink);
        line-height: 1;
        letter-spacing: -.02em;
        margin-bottom: 4px;
    }

    .lm-prix-label {
        font-family: 'DM Mono',monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: var(--hint);
    }

    .lm-prix-note {
        font-family: 'DM Mono',monospace;
        font-size: 11px;
        color: var(--forest);
        margin-top: 6px;
    }

    /* Specs bar */
    .lm-specs-bar {
        display: flex;
        gap: 0;
        padding-bottom: 0;
    }

    .lm-spec {
        flex: 1;
        padding: 0 24px;
        border-right: .5px solid var(--border);
        text-align: center;
    }

        .lm-spec:first-child {
            padding-left: 0;
            text-align: left;
        }

        .lm-spec:last-child {
            border-right: none;
        }

    .lm-spec-val {
        font-size: 26px;
        font-weight: 300;
        color: var(--ink);
        line-height: 1;
        margin-bottom: 4px;
    }

    .lm-spec-label {
        font-family: 'DM Mono',monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: var(--hint);
    }

    /* ── BODY LAYOUT ── */
    .lm-body {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 64px;
        padding: 64px 0 80px;
        align-items: start;
    }

    /* ── SECTIONS ── */
    .lm-section {
        margin-bottom: 52px;
    }

    .lm-section-label {
        font-family: 'DM Mono',monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--forest);
        margin-bottom: 14px;
    }

    .lm-section-h2 {
        font-size: clamp(26px,3vw,40px);
        font-weight: 300;
        line-height: 1.05;
        color: var(--ink);
        margin-bottom: 16px;
        letter-spacing: -.01em;
    }

        .lm-section-h2 em {
            font-style: italic;
            color: var(--muted);
        }

    .lm-text {
        font-family: 'DM Mono',monospace;
        font-size: 12px;
        font-weight: 300;
        line-height: 1.8;
        color: var(--muted);
        letter-spacing: .02em;
    }

    /* ── ATOUTS ── */
    .lm-atouts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: var(--border);
        margin-top: 28px;
    }

    .lm-atout {
        background: var(--cream);
        padding: 24px 26px;
        border-left: 2px solid transparent;
        transition: all .18s;
    }

        .lm-atout:hover {
            background: #fff;
            border-left-color: var(--forest);
        }

    .lm-atout-title {
        font-size: 17px;
        font-weight: 300;
        color: var(--ink);
        margin-bottom: 5px;
    }

    .lm-atout-desc {
        font-family: 'DM Mono',monospace;
        font-size: 10px;
        font-weight: 300;
        color: var(--hint);
        line-height: 1.6;
        letter-spacing: .03em;
    }

    /* ── COMPOSITION ── */
    .lm-compo-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 1px;
        background: var(--border);
        margin-top: 28px;
    }

    .lm-compo-card {
        background: var(--cream);
        padding: 28px 24px;
        position: relative;
        overflow: hidden;
        transition: background .18s;
    }

        .lm-compo-card:hover {
            background: #fff;
        }

        .lm-compo-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--forest);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .3s;
        }

        .lm-compo-card:hover::before {
            transform: scaleX(1);
        }

    .lm-compo-num {
        font-family: 'DM Mono',monospace;
        font-size: 28px;
        font-weight: 300;
        color: var(--forest);
        line-height: 1;
        margin-bottom: 6px;
    }

    .lm-compo-name {
        font-size: 20px;
        font-weight: 300;
        color: var(--ink);
        margin-bottom: 4px;
    }

    .lm-compo-type {
        font-family: 'DM Mono',monospace;
        font-size: 9px;
        font-weight: 300;
        color: var(--hint);
        letter-spacing: .1em;
        margin-bottom: 12px;
        text-transform: uppercase;
    }

    .lm-compo-specs {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .lm-compo-spec {
        font-family: 'DM Mono',monospace;
        font-size: 10px;
        font-weight: 300;
        color: var(--muted);
        display: flex;
        justify-content: space-between;
    }

        .lm-compo-spec span:last-child {
            color: var(--ink);
        }

    /* ── SURFACES ── */
    .lm-surfaces {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 1px;
        background: var(--border);
        margin-top: 28px;
    }

    .lm-surface-item {
        background: var(--cream);
        padding: 20px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: background .15s;
    }

        .lm-surface-item:hover {
            background: #fff;
        }

    .lm-surface-pct {
        font-size: 22px;
        font-weight: 300;
        color: var(--forest);
        min-width: 52px;
        line-height: 1;
    }

    .lm-surface-info {
        flex: 1;
    }

    .lm-surface-val {
        font-size: 17px;
        font-weight: 300;
        color: var(--ink);
        margin-bottom: 2px;
    }

    .lm-surface-label {
        font-family: 'DM Mono',monospace;
        font-size: 9px;
        font-weight: 300;
        color: var(--hint);
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    /* ── OPPORTUNITE INVEST ── */
    .lm-invest {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        background: var(--border);
        margin-top: 28px;
    }

    .lm-invest-left {
        background: var(--forest);
        padding: 40px 36px;
        position: relative;
        overflow: hidden;
    }

        .lm-invest-left::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(212,180,131,.05) 1px,transparent 1px), linear-gradient(90deg,rgba(212,180,131,.05) 1px,transparent 1px);
            background-size: 36px 36px;
        }

    .lm-invest-left-content {
        position: relative;
        z-index: 2;
    }

    .lm-invest-title {
        font-size: 26px;
        font-weight: 300;
        color: #fff;
        line-height: 1.15;
        margin-bottom: 20px;
    }

        .lm-invest-title em {
            font-style: italic;
            color: var(--gold2);
        }

    .lm-invest-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

        .lm-invest-list li {
            font-family: 'DM Mono',monospace;
            font-size: 11px;
            font-weight: 300;
            color: rgba(255,255,255,.45);
            letter-spacing: .03em;
            padding-left: 16px;
            position: relative;
            line-height: 1.55;
        }

            .lm-invest-list li::before {
                content: '→';
                position: absolute;
                left: 0;
                color: var(--gold);
                opacity: .7;
            }

    .lm-invest-right {
        background: var(--warm);
        padding: 40px 36px;
    }

    .lm-invest-quote {
        font-size: 22px;
        font-weight: 300;
        font-style: italic;
        line-height: 1.3;
        color: var(--ink);
        letter-spacing: -.01em;
        padding-bottom: 24px;
        border-bottom: .5px solid var(--border);
        margin-bottom: 24px;
    }

        .lm-invest-quote em {
            color: var(--forest);
        }

    .lm-invest-kpis {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .lm-invest-kpi {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .lm-invest-kpi-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--forest);
        flex-shrink: 0;
        margin-top: 6px;
    }

    .lm-invest-kpi-text {
        font-family: 'DM Mono',monospace;
        font-size: 11px;
        font-weight: 300;
        color: var(--muted);
        line-height: 1.6;
        letter-spacing: .03em;
    }

    /* ── LOCALISATION ── */
    .lm-prox-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        margin-top: 28px;
    }

    .lm-prox-title {
        font-family: 'DM Mono',monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: var(--forest);
        margin-bottom: 16px;
    }

    .lm-prox-list {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .lm-prox-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 0;
        border-bottom: .5px solid var(--border);
    }

    .lm-prox-name {
        font-family: 'DM Mono',monospace;
        font-size: 11px;
        font-weight: 300;
        color: var(--muted);
    }

    .lm-prox-dist {
        font-family: 'DM Mono',monospace;
        font-size: 11px;
        font-weight: 400;
        color: var(--forest);
    }

    /* ── SIDEBAR ── */
    .lm-sidebar {
        position: sticky;
        top: 88px;
    }

    .lm-cta-card {
        background: var(--forest);
        padding: 36px 32px;
        margin-bottom: 16px;
        position: relative;
        overflow: hidden;
    }

        .lm-cta-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(212,180,131,.04) 1px,transparent 1px), linear-gradient(90deg,rgba(212,180,131,.04) 1px,transparent 1px);
            background-size: 32px 32px;
        }

    .lm-cta-content {
        position: relative;
        z-index: 2;
    }

    .lm-cta-pretitle {
        font-family: 'DM Mono',monospace;
        font-size: 8px;
        font-weight: 300;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 10px;
    }

    .lm-cta-title {
        font-size: 26px;
        font-weight: 300;
        color: #fff;
        line-height: 1.15;
        margin-bottom: 8px;
    }

        .lm-cta-title em {
            font-style: italic;
            color: var(--gold2);
        }

    .lm-cta-sub {
        font-family: 'DM Mono',monospace;
        font-size: 10px;
        font-weight: 300;
        color: rgba(255,255,255,.35);
        line-height: 1.65;
        margin-bottom: 28px;
        letter-spacing: .03em;
    }

    .lm-btn-primary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 16px;
        font-family: 'DM Mono',monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: var(--ink);
        background: var(--gold);
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: background .2s;
        margin-bottom: 8px;
    }

        .lm-btn-primary:hover {
            background: var(--gold2);
            color: var(--ink);
        }

    .lm-btn-secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 14px;
        font-family: 'DM Mono',monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: rgba(255,255,255,.4);
        background: none;
        border: .5px solid rgba(255,255,255,.12);
        cursor: pointer;
        text-decoration: none;
        transition: all .2s;
    }

        .lm-btn-secondary:hover {
            border-color: rgba(255,255,255,.35);
            color: #fff;
        }

    .lm-info-card {
        background: var(--warm);
        padding: 28px 28px;
        border: .5px solid var(--border);
    }

    .lm-info-title {
        font-family: 'DM Mono',monospace;
        font-size: 8px;
        font-weight: 300;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: var(--forest);
        margin-bottom: 18px;
    }

    .lm-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: .5px solid var(--border);
    }

        .lm-info-row:last-child {
            border-bottom: none;
        }

    .lm-info-key {
        font-family: 'DM Mono',monospace;
        font-size: 10px;
        font-weight: 300;
        color: var(--hint);
    }

    .lm-info-val {
        font-size: 14px;
        font-weight: 300;
        color: var(--ink);
        text-align: right;
    }

    /* ── CTA FINAL ── */
    .lm-final {
        background: var(--forest);
        padding: 80px 0;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        position: relative;
        overflow: hidden;
    }

        .lm-final::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(212,180,131,.04) 1px,transparent 1px), linear-gradient(90deg,rgba(212,180,131,.04) 1px,transparent 1px);
            background-size: 48px 48px;
        }

    .lm-final-content {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 48px;
    }

    .lm-final-title {
        font-size: clamp(26px,3.5vw,44px);
        font-weight: 300;
        color: #fff;
        line-height: 1.1;
        letter-spacing: -.01em;
    }

        .lm-final-title em {
            font-style: italic;
            color: var(--gold2);
        }

    .lm-final-sub {
        font-family: 'DM Mono',monospace;
        font-size: 11px;
        font-weight: 300;
        color: rgba(255,255,255,.35);
        margin-top: 10px;
        line-height: 1.65;
        letter-spacing: .04em;
    }

    .lm-final-btn {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: 'DM Mono',monospace;
        font-size: 10px;
        font-weight: 300;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        background: var(--gold);
        padding: 18px 36px;
        transition: background .2s,transform .15s;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .lm-final-btn:hover {
            background: var(--gold2);
            color: var(--ink);
            transform: translateY(-2px);
        }

    /* ── LIGHTBOX ── */
    .lm-lightbox {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(12,12,10,.95);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 40px;
    }

        .lm-lightbox.open {
            display: flex;
        }

        .lm-lightbox img {
            max-width: 100%;
            max-height: 90vh;
            object-fit: contain;
        }

    .lm-lightbox-close {
        position: absolute;
        top: 20px;
        right: 24px;
        font-family: 'DM Mono',monospace;
        font-size: 11px;
        color: rgba(255,255,255,.4);
        background: none;
        border: none;
        cursor: pointer;
        letter-spacing: .1em;
    }

        .lm-lightbox-close:hover {
            color: #fff;
        }

    .lm-lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,.08);
        border: .5px solid rgba(255,255,255,.15);
        color: #fff;
        font-size: 20px;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background .15s;
    }

        .lm-lightbox-nav:hover {
            background: rgba(255,255,255,.18);
        }

    .lm-lightbox-prev {
        left: 20px;
    }

    .lm-lightbox-next {
        right: 20px;
    }

    .lm-lightbox-counter {
        position: absolute;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        font-family: 'DM Mono',monospace;
        font-size: 10px;
        color: rgba(255,255,255,.3);
        letter-spacing: .12em;
    }

    /* Responsive */
    @@media (max-width:1100px) {
        .lm-compo-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media (max-width:900px) {
        .lm-gallery {
            height: 500px;
            grid-template-rows: 1fr 1fr;
        }

        .lm-body {
            grid-template-columns: 1fr;
        }

        .lm-sidebar {
            position: static;
        }

        .lm-header-grid {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .lm-prix-bloc {
            text-align: left;
        }

        .lm-invest {
            grid-template-columns: 1fr;
        }

        .lm-prox-grid {
            grid-template-columns: 1fr;
        }

        .lm-final-content {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width:640px) {
        .lm-gallery {
            grid-template-columns: 1fr;
