@{
    ViewData["Title"] = "Terraços de Joane – Appartements neufs T0, T2, T3 | Joane, Famalicão";
    ViewData["Description"] = "Programme résidentiel neuf Terraços de Joane à Joane, Vila Nova de Famalicão. T0, T2, T3 avec terrasse panoramique. À partir de 113 520 €.";
}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet" />

<style>
    :root {
        --ink: #0c0c0a;
        --cream: #f5f3ee;
        --warm: #ece8df;
        --gold: #b8935a;
        --gold2: #d4b483;
        --muted: #78766e;
        --hint: #aeac9f;
        --border: rgba(12,12,10,0.09);
        --teal: #1e4a5a;
    }

    .tj {
        font-family: 'Cormorant Garamond', Georgia, serif;
        background: var(--cream);
        color: var(--ink);
        overflow-x: hidden;
    }

    /* ── HERO PROGRAMME ── */
    .tj-hero {
        background: var(--teal);
        min-height: 88vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        position: relative;
        overflow: hidden;
    }

        .tj-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(212,180,131,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(212,180,131,0.06) 1px, transparent 1px);
            background-size: 48px 48px;
        }

    .tj-hero-left {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 80px 64px;
        position: relative;
        z-index: 2;
    }

    .tj-hero-right {
        position: relative;
        overflow: hidden;
        border-left: 0.5px solid rgba(212,180,131,0.15);
    }

    .tj-hero-right-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        opacity: 0.55;
        transition: opacity .4s;
    }

    .tj-hero-right:hover .tj-hero-right-img {
        opacity: 0.7;
    }

    .tj-hero-right-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, var(--teal) 0%, transparent 40%);
    }

    /* Badges programme */
    .tj-badges {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

    .tj-badge {
        font-family: 'DM Mono', monospace;
        font-size: 8px;
        font-weight: 300;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--teal);
        background: var(--gold2);
        padding: 5px 12px;
    }

    .tj-badge-outline {
        font-family: 'DM Mono', monospace;
        font-size: 8px;
        font-weight: 300;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.6);
        border: 0.5px solid rgba(212,180,131,0.35);
        padding: 5px 12px;
    }

    .tj-pretitle {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .tj-pretitle::before {
            content: '';
            width: 20px;
            height: 1px;
            background: var(--gold);
            display: block;
        }

    .tj-hero-h1 {
        font-size: clamp(42px, 5vw, 76px);
        font-weight: 300;
        line-height: 0.94;
        color: #fff;
        margin-bottom: 12px;
        letter-spacing: -0.02em;
    }

        .tj-hero-h1 em {
            font-style: italic;
            color: var(--gold2);
            display: block;
        }

    .tj-hero-sub {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        font-weight: 300;
        color: rgba(255,255,255,0.45);
        line-height: 1.7;
        letter-spacing: 0.04em;
        max-width: 380px;
        margin-bottom: 40px;
    }

    .tj-hero-stats {
        display: flex;
        gap: 32px;
        padding-top: 28px;
        border-top: 0.5px solid rgba(212,180,131,0.2);
    }

    .tj-hero-stat-num {
        font-size: 28px;
        font-weight: 300;
        color: var(--gold2);
        line-height: 1;
    }

    .tj-hero-stat-label {
        font-family: 'DM Mono', monospace;
        font-size: 8px;
        font-weight: 300;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.3);
        margin-top: 4px;
    }

    /* ── BANDE PRIX ── */
    .tj-prix-band {
        background: var(--ink);
        padding: 20px 0;
        border-bottom: 0.5px solid rgba(212,180,131,0.15);
    }

    .tj-prix-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
    }

    .tj-prix-item {
        text-align: center;
    }

    .tj-prix-label {
        font-family: 'DM Mono', monospace;
        font-size: 8px;
        font-weight: 300;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--hint);
        margin-bottom: 4px;
    }

    .tj-prix-val {
        font-size: 20px;
        font-weight: 300;
        color: var(--gold2);
    }

    .tj-prix-sep {
        width: 0.5px;
        height: 40px;
        background: rgba(255,255,255,0.06);
    }

    /* ── SECTIONS ── */
    .tj-section {
        padding: 72px 0;
        border-bottom: 0.5px solid var(--border);
    }

    .tj-section-label {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 14px;
    }

    .tj-section-h2 {
        font-size: clamp(28px, 3.5vw, 44px);
        font-weight: 300;
        line-height: 1.05;
        color: var(--ink);
        margin-bottom: 20px;
        letter-spacing: -0.01em;
    }

        .tj-section-h2 em {
            font-style: italic;
            color: var(--muted);
        }

    .tj-text {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
        font-weight: 300;
        line-height: 1.8;
        color: var(--muted);
        letter-spacing: 0.02em;
    }

    /* ── GRID TYPOLOGIES ── */
    .tj-typo-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--border);
        margin-top: 40px;
    }

    .tj-typo-card {
        background: var(--cream);
        padding: 36px 32px;
        transition: background .18s;
        position: relative;
        overflow: hidden;
    }

        .tj-typo-card:hover {
            background: #fff;
        }

        .tj-typo-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--gold);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .3s;
        }

        .tj-typo-card:hover::before {
            transform: scaleX(1);
        }

    .tj-typo-ref {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        color: var(--gold);
        letter-spacing: 0.1em;
        margin-bottom: 12px;
        opacity: 0.8;
    }

    .tj-typo-name {
        font-size: 32px;
        font-weight: 300;
        color: var(--ink);
        line-height: 1;
        margin-bottom: 4px;
    }

    .tj-typo-surface {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        font-weight: 300;
        color: var(--hint);
        margin-bottom: 20px;
    }

    .tj-typo-specs {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
        padding: 16px 0;
        border-top: 0.5px solid var(--border);
        border-bottom: 0.5px solid var(--border);
    }

    .tj-typo-spec {
        display: flex;
        justify-content: space-between;
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 300;
        color: var(--muted);
    }

        .tj-typo-spec span:last-child {
            color: var(--ink);
            font-weight: 400;
        }

    .tj-typo-prix {
        font-size: 22px;
        font-weight: 300;
        color: var(--ink);
        margin-bottom: 4px;
    }

    .tj-typo-prix-label {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        color: var(--hint);
        letter-spacing: 0.08em;
    }

    .tj-typo-tag {
        display: inline-block;
        font-family: 'DM Mono', monospace;
        font-size: 8px;
        font-weight: 300;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 4px 10px;
        margin-top: 12px;
    }

    .tj-typo-tag-libre {
        background: rgba(184,147,90,0.15);
        color: var(--gold);
    }

    .tj-typo-tag-reserve {
        background: rgba(12,12,10,0.08);
        color: var(--muted);
    }

    /* ── TABLEAU LOTES ── */
    .tj-table-wrap {
        margin-top: 40px;
        overflow-x: auto;
        border: 0.5px solid var(--border);
    }

    .tj-table {
        width: 100%;
        border-collapse: collapse;
        font-family: 'DM Mono', monospace;
    }

        .tj-table thead tr {
            background: var(--ink);
        }

        .tj-table thead th {
            font-size: 8px;
            font-weight: 300;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.5);
            padding: 14px 20px;
            text-align: left;
            border-right: 0.5px solid rgba(255,255,255,0.05);
            white-space: nowrap;
        }

        .tj-table tbody tr {
            border-bottom: 0.5px solid var(--border);
            transition: background .12s;
        }

            .tj-table tbody tr:hover {
                background: #fff;
            }

        .tj-table tbody td {
            font-size: 12px;
            font-weight: 300;
            color: var(--muted);
            padding: 14px 20px;
            border-right: 0.5px solid var(--border);
            white-space: nowrap;
        }

            .tj-table tbody td:first-child {
                color: var(--gold);
                font-weight: 400;
            }

            .tj-table tbody td.prix {
                color: var(--ink);
                font-weight: 400;
            }

    .tj-status-libre {
        display: inline-block;
        background: rgba(184,147,90,0.12);
        color: var(--gold);
        font-size: 8px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 3px 8px;
    }

    .tj-status-reserve {
        display: inline-block;
        background: rgba(12,12,10,0.07);
        color: var(--hint);
        font-size: 8px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 3px 8px;
    }

    /* ── CONDITIONS ACQUISITION ── */
    .tj-acq-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1px;
        background: var(--border);
        margin-top: 40px;
    }

    .tj-acq-step {
        background: var(--cream);
        padding: 32px 24px;
        transition: background .18s;
    }

        .tj-acq-step:hover {
            background: #fff;
        }

    .tj-acq-num {
        font-family: 'DM Mono', monospace;
        font-size: 28px;
        font-weight: 300;
        color: var(--gold);
        line-height: 1;
        margin-bottom: 8px;
    }

    .tj-acq-label {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--hint);
        margin-bottom: 8px;
    }

    .tj-acq-desc {
        font-size: 15px;
        font-weight: 300;
        color: var(--ink);
        line-height: 1.3;
    }

    /* ── ATOUTS ── */
    .tj-atouts {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--border);
        margin-top: 40px;
    }

    .tj-atout {
        background: var(--cream);
        padding: 28px 28px;
        border-left: 2px solid transparent;
        transition: all .18s;
    }

        .tj-atout:hover {
            background: #fff;
            border-left-color: var(--gold);
        }

    .tj-atout-icon {
        font-size: 20px;
        margin-bottom: 12px;
    }

    .tj-atout-title {
        font-size: 18px;
        font-weight: 300;
        color: var(--ink);
        margin-bottom: 6px;
    }

    .tj-atout-desc {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 300;
        color: var(--hint);
        line-height: 1.6;
        letter-spacing: 0.03em;
    }

    /* ── PROXIMITÉS ── */
    .tj-prox-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 48px;
        margin-top: 40px;
    }

    .tj-prox-col-title {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 20px;
    }

    .tj-prox-list {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .tj-prox-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 0.5px solid var(--border);
    }

    .tj-prox-name {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        font-weight: 300;
        color: var(--muted);
    }

    .tj-prox-dist {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        font-weight: 400;
        color: var(--gold);
    }

    /* ── CTA SIDEBAR LAYOUT ── */
    .tj-body-layout {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 64px;
        align-items: start;
    }

    .tj-sidebar {
        position: sticky;
        top: 88px;
    }

    .tj-cta-card {
        background: var(--ink);
        padding: 36px 32px;
        position: relative;
        overflow: hidden;
        margin-bottom: 16px;
    }

        .tj-cta-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(212,180,131,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(212,180,131,0.04) 1px, transparent 1px);
            background-size: 32px 32px;
        }

    .tj-cta-content {
        position: relative;
        z-index: 2;
    }

    .tj-cta-pretitle {
        font-family: 'DM Mono', monospace;
        font-size: 8px;
        font-weight: 300;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 12px;
    }

    .tj-cta-title {
        font-size: 26px;
        font-weight: 300;
        color: #fff;
        line-height: 1.15;
        margin-bottom: 8px;
    }

        .tj-cta-title em {
            font-style: italic;
            color: var(--gold2);
        }

    .tj-cta-sub {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 300;
        color: rgba(255,255,255,0.35);
        line-height: 1.65;
        margin-bottom: 28px;
        letter-spacing: 0.03em;
    }

    .tj-btn-primary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 16px;
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
        background: var(--gold);
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: background .2s;
        margin-bottom: 8px;
    }

        .tj-btn-primary:hover {
            background: var(--gold2);
            color: var(--ink);
        }

    .tj-btn-secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 14px;
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
        background: none;
        border: 0.5px solid rgba(255,255,255,0.12);
        cursor: pointer;
        text-decoration: none;
        transition: all .2s;
    }

        .tj-btn-secondary:hover {
            border-color: rgba(255,255,255,0.35);
            color: #fff;
        }

    .tj-info-card {
        background: var(--warm);
        padding: 28px 28px;
        border: 0.5px solid var(--border);
    }

    .tj-info-title {
        font-family: 'DM Mono', monospace;
        font-size: 8px;
        font-weight: 300;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 18px;
    }

    .tj-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 0.5px solid var(--border);
    }

        .tj-info-row:last-child {
            border-bottom: none;
        }

    .tj-info-key {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 300;
        color: var(--hint);
    }

    .tj-info-val {
        font-size: 15px;
        font-weight: 300;
        color: var(--ink);
        text-align: right;
    }

    /* ── CTA FINAL ── */
    .tj-final {
        background: var(--teal);
        padding: 80px 0;
        position: relative;
        overflow: hidden;
    }

        .tj-final::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(212,180,131,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(212,180,131,0.04) 1px, transparent 1px);
            background-size: 48px 48px;
        }

    .tj-final-content {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 48px;
    }

    .tj-final-title {
        font-size: clamp(28px, 3.5vw, 46px);
        font-weight: 300;
        color: #fff;
        line-height: 1.1;
        letter-spacing: -0.01em;
    }

        .tj-final-title em {
            font-style: italic;
            color: var(--gold2);
        }

    .tj-final-sub {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        font-weight: 300;
        color: rgba(255,255,255,0.35);
        margin-top: 10px;
        line-height: 1.65;
        letter-spacing: 0.04em;
    }

    .tj-final-btn {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 300;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        background: var(--gold);
        padding: 18px 36px;
        transition: background .2s, transform .15s;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .tj-final-btn:hover {
            background: var(--gold2);
            color: var(--ink);
            transform: translateY(-2px);
        }

    /* Responsive */
    @@media (max-width: 1100px) {
        .tj-typo-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .tj-acq-grid {
            grid-template-columns: repeat(3,1fr);
        }
    }

    @@media (max-width: 900px) {
        .tj-hero {
            grid-template-columns: 1fr;
        }

        .tj-hero-right {
            display: none;
        }

        .tj-hero-left {
            min-height: 60vh;
            padding: 80px 28px 48px;
        }

        .tj-body-layout {
            grid-template-columns: 1fr;
        }

        .tj-sidebar {
            position: static;
        }

        .tj-prox-grid {
            grid-template-columns: 1fr;
        }

        .tj-final-content {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .tj-typo-grid {
            grid-template-columns: 1fr;
        }

        .tj-acq-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .tj-atouts {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="tj">

    <!-- ── HERO ── -->
    <section class="tj-hero">
        <div class="tj-hero-left">
            <div class="tj-badges">
                <span class="tj-badge">Nouveau programme</span>
                <span class="tj-badge-outline">15 lots · T0 / T2 / T3</span>
                <span class="tj-badge-outline">Livraison 2026</span>
            </div>
            <p class="tj-pretitle">Terraços de Joane · Joane, Famalicão</p>
            <h1 class="tj-hero-h1">
                Viver bem<br>
                <em>é investir no futuro</em>
            </h1>
            <p class="tj-hero-sub">
                Appartements contemporains conçus pour ceux qui valorisent le confort, la localisation stratégique et la valorisation patrimoniale. Joane, Vila Nova de Famalicão.
            </p>
            <div class="tj-hero-stats">
                <div>
                    <div class="tj-hero-stat-num">15</div>
                    <div class="tj-hero-stat-label">Lots disponibles</div>
                </div>
                <div>
                    <div class="tj-hero-stat-num">4</div>
