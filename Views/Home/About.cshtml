@{
    ViewData["Title"] = "À propos – Human Square | Conseil & Investissement Immobilier au Portugal";
    ViewData["Description"] = "Human Square accompagne stratégiquement les projets immobiliers au Portugal depuis 2017. Découvrez notre équipe et notre expertise.";
}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Outfit:wght@200;300;400;500&display=swap" rel="stylesheet" />

<style>
    :root {
        --ink: #0e0e0c;
        --cream: #f7f5f0;
        --warm: #ede9e1;
        --gold: #c9a96e;
        --gold2: #e8d5b0;
        --muted: #7a7870;
        --hint: #b0ae9f;
        --border: rgba(14,14,12,0.1);
    }

    .ap-page {
        font-family: 'Outfit', sans-serif;
        color: var(--ink);
        background: var(--cream);
    }

    /* ── HERO ── */
    .ap-hero {
        position: relative;
        height: 60vh;
        min-height: 420px;
        display: flex;
        align-items: flex-end;
        padding-bottom: 64px;
        overflow: hidden;
        background: var(--ink);
    }

    .ap-hero-img {
        position: absolute;
        inset: 0;
        background-image: url('/images/background-a-propos-porto.png');
        background-size: cover;
        background-position: center 30%;
        opacity: 0.35;
    }

    .ap-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(14,14,12,0.85) 0%, rgba(14,14,12,0.2) 60%, transparent 100%);
    }

    .ap-hero-content {
        position: relative;
        z-index: 2;
        max-width: 680px;
        padding: 0 24px;
    }

    .ap-eyebrow {
        font-size: 10px;
        font-weight: 400;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .ap-eyebrow::before {
            content: '';
            display: block;
            width: 32px;
            height: 0.5px;
            background: var(--gold);
            opacity: 0.6;
        }

    .ap-hero-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(36px, 5vw, 60px);
        font-weight: 300;
        line-height: 1.08;
        color: #fff;
        margin-bottom: 16px;
    }

        .ap-hero-title em {
            font-style: italic;
            color: var(--gold2);
        }

    .ap-hero-sub {
        font-size: 14px;
        font-weight: 300;
        color: rgba(255,255,255,0.55);
        line-height: 1.75;
        max-width: 520px;
    }

    /* ── INTRO ── */
    .ap-intro {
        background: var(--cream);
        padding: 88px 0;
        border-bottom: 0.5px solid var(--border);
    }

    .ap-intro-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: center;
    }

    .ap-intro-label {
        font-size: 10px;
        font-weight: 400;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 16px;
    }

    .ap-intro-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(28px, 3.5vw, 42px);
        font-weight: 300;
        line-height: 1.15;
        color: var(--ink);
        margin-bottom: 24px;
    }

        .ap-intro-title em {
            font-style: italic;
            color: var(--muted);
        }

    .ap-intro-text {
        font-size: 14px;
        font-weight: 300;
        color: var(--muted);
        line-height: 1.8;
        margin-bottom: 16px;
    }

        .ap-intro-text strong {
            font-weight: 500;
            color: var(--ink);
        }

    .ap-presence {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 28px;
    }

    .ap-presence-tag {
        font-size: 11px;
        font-weight: 300;
        color: var(--muted);
        padding: 6px 14px;
        border: 0.5px solid var(--border);
        border-radius: 20px;
        background: #fff;
        letter-spacing: 0.04em;
    }

    .ap-intro-img {
        position: relative;
    }

        .ap-intro-img img {
            width: 100%;
            height: 460px;
            object-fit: cover;
            display: block;
        }

        .ap-intro-img::after {
            content: '';
            position: absolute;
            bottom: -16px;
            right: -16px;
            width: 120px;
            height: 120px;
            border: 0.5px solid var(--gold);
            opacity: 0.4;
            pointer-events: none;
        }

    /* ── CHIFFRES ── */
    .ap-stats {
        background: var(--ink);
        padding: 72px 0;
    }

    .ap-stats-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 0;
    }

    .ap-stat {
        padding: 40px 32px;
        border-right: 0.5px solid rgba(255,255,255,0.08);
        text-align: center;
    }

        .ap-stat:last-child {
            border-right: none;
        }

    .ap-stat-num {
        font-family: 'Cormorant Garamond', serif;
        font-size: 52px;
        font-weight: 300;
        color: #fff;
        line-height: 1;
        margin-bottom: 8px;
    }

    .ap-stat-label {
        font-size: 10px;
        font-weight: 300;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.35);
    }

    .ap-stat-gold {
        color: var(--gold);
    }

    /* ── EXPERTISES ── */
    .ap-expertises {
        background: var(--cream);
        padding: 88px 0;
    }

    .ap-section-header {
        text-align: center;
        margin-bottom: 64px;
    }

    .ap-section-eyebrow {
        font-size: 10px;
        font-weight: 400;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 12px;
    }

    .ap-section-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(30px, 4vw, 46px);
        font-weight: 300;
        color: var(--ink);
        line-height: 1.1;
        margin-bottom: 12px;
    }

        .ap-section-title em {
            font-style: italic;
            color: var(--muted);
        }

    .ap-section-sub {
        font-size: 14px;
        font-weight: 300;
        color: var(--hint);
        max-width: 480px;
        margin: 0 auto;
        line-height: 1.7;
    }

    /* Grille expertises */
    .ap-exp-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 1px;
        background: var(--border);
    }

    .ap-exp-item {
        background: #fff;
        padding: 36px 32px;
        display: flex;
        align-items: flex-start;
        gap: 20px;
        transition: background .2s;
    }

        .ap-exp-item:hover {
            background: var(--warm);
        }

    .ap-exp-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: var(--warm);
        border: 0.5px solid rgba(201,169,110,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
        transition: border-color .2s;
    }

    .ap-exp-item:hover .ap-exp-icon {
        border-color: var(--gold);
    }

    .ap-exp-icon img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .ap-exp-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 18px;
        font-weight: 400;
        color: var(--ink);
        line-height: 1.3;
        padding-top: 12px;
    }

    /* ── PRÉSENCE GÉOGRAPHIQUE ── */
    .ap-geo {
        background: var(--warm);
        padding: 72px 0;
        border-top: 0.5px solid var(--border);
        border-bottom: 0.5px solid var(--border);
    }

    .ap-geo-grid {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 64px;
        align-items: center;
    }

    .ap-geo-cities {
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: 1px;
        background: var(--border);
    }

    .ap-geo-city {
        background: #fff;
        padding: 24px 20px;
        text-align: center;
        transition: background .2s;
    }

        .ap-geo-city:hover {
            background: var(--cream);
        }

    .ap-geo-city-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 16px;
        font-weight: 400;
        color: var(--ink);
        margin-bottom: 4px;
    }

    .ap-geo-city-label {
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--hint);
    }

    /* ── CTA ── */
    .ap-cta {
        background: var(--ink);
        padding: 88px 0;
        position: relative;
        overflow: hidden;
    }

    .ap-cta-glow {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 50% 80% at 70% 50%, rgba(201,169,110,0.07) 0%, transparent 70%);
    }

    .ap-cta-inner {
        position: relative;
        z-index: 2;
        max-width: 560px;
        margin: 0 auto;
        text-align: center;
        padding: 0 24px;
    }

    .ap-cta-eyebrow {
        font-size: 10px;
        font-weight: 300;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

        .ap-cta-eyebrow::before, .ap-cta-eyebrow::after {
            content: '';
            display: block;
            width: 28px;
            height: 0.5px;
            background: var(--gold);
            opacity: 0.5;
        }

    .ap-cta-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(28px, 4vw, 44px);
        font-weight: 300;
        color: #fff;
        line-height: 1.12;
        margin-bottom: 16px;
    }

        .ap-cta-title em {
            font-style: italic;
            color: var(--gold2);
        }

    .ap-cta-sub {
        font-size: 14px;
        font-weight: 300;
        color: rgba(255,255,255,0.45);
        line-height: 1.75;
        margin-bottom: 36px;
    }

    .ap-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        background: var(--gold);
        padding: 15px 38px;
        border-radius: 2px;
        transition: background .2s, transform .2s;
    }

        .ap-cta-btn:hover {
            background: var(--gold2);
            color: var(--ink);
            transform: translateY(-2px);
        }

    /* ── Responsive ── */
    @@media (max-width: 992px) {
        .ap-intro-grid {
            grid-template-columns: 1fr;
            gap: 48px;
        }

        .ap-intro-img::after {
            display: none;
        }

        .ap-stats-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .ap-stat {
            border-right: none;
            border-bottom: 0.5px solid rgba(255,255,255,0.08);
        }

        .ap-exp-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .ap-geo-grid {
            grid-template-columns: 1fr;
            gap: 36px;
        }

        .ap-geo-cities {
            grid-template-columns: repeat(3,1fr);
        }
    }

    @@media (max-width: 640px) {
        .ap-exp-grid {
            grid-template-columns: 1fr;
        }

        .ap-stats-grid {
            grid-template-columns: 1fr;
        }

        .ap-geo-cities {
            grid-template-columns: repeat(2,1fr);
        }

        .ap-hero {
            height: auto;
            padding: 100px 0 56px;
        }
    }
</style>

<div class="ap-page">

    <!-- ── HERO ── -->
    <section class="ap-hero">
        <div class="ap-hero-img"></div>
        <div class="ap-hero-overlay"></div>
        <div class="container">
            <div class="ap-hero-content">
                <p class="ap-eyebrow">Human Square · Portugal</p>
                <h1 class="ap-hero-title">
                    Une expertise<br><em>au service de votre projet</em>
                </h1>
                <p class="ap-hero-sub">
                    Depuis 2017, Human Square accompagne particuliers, investisseurs et promoteurs dans leurs projets immobiliers au Portugal — avec rigueur, proximité et une vision stratégique sur mesure.
                </p>
            </div>
        </div>
    </section>

    <!-- ── INTRO ── -->
    <section class="ap-intro">
        <div class="container">
            <div class="ap-intro-grid">
                <div>
                    <p class="ap-intro-label">Qui sommes-nous</p>
                    <h2 class="ap-intro-title">
                        Une équipe<br><em>pluridisciplinaire</em><br>à votre service
                    </h2>
                    <p class="ap-intro-text">
                        <strong>Human Square</strong> est une entreprise spécialisée dans l'accompagnement stratégique de projets immobiliers. Notre force repose sur une équipe pluridisciplinaire, composée de professionnels expérimentés dans tous les domaines clés de l'investissement au Portugal.
                    </p>
                    <p class="ap-intro-text">
                        De la première idée à la remise des clés, nous coordonnons chaque étape avec précision — étude de faisabilité, acquisition, architecture, construction, gestion administrative et commercialisation.
                    </p>

                    <div class="ap-presence">
                        <span class="ap-presence-tag">📍 Vila do Conde</span>
                        <span class="ap-presence-tag">📍 Porto</span>
                        <span class="ap-presence-tag">📍 Lisbonne</span>
                        <span class="ap-presence-tag">📍 Viseu</span>
                        <span class="ap-presence-tag">📍 Albufeira</span>
                    </div>
                </div>

                <div class="ap-intro-img">
                    <img src="/images/VC00.jpg" alt="Vila do Conde, Portugal" />
                </div>
            </div>
        </div>
    </section>

    <!-- ── CHIFFRES CLÉS ── -->
    <section class="ap-stats">
        <div class="container">
            <div class="ap-stats-grid">
                <div class="ap-stat">
                    <div class="ap-stat-num ap-stat-gold">
                        <span class="counter" data-target="2017">2017</span>
                    </div>
                    <div class="ap-stat-label">Année de création</div>
                </div>
                <div class="ap-stat">
                    <div class="ap-stat-num">
                        <span class="counter" data-target="52">52</span>
                    </div>
                    <div class="ap-stat-label">Projets accompagnés</div>
                </div>
                <div class="ap-stat">
                    <div class="ap-stat-num">
                        <span class="counter" data-target="784">784</span>
                    </div>
                    <div class="ap-stat-label">Sessions de coaching</div>
                </div>
                <div class="ap-stat">
                    <div class="ap-stat-num">
                        <span class="counter" data-target="191">191</span>
                    </div>
                    <div class="ap-stat-label">Formations réalisées</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ── EXPERTISES ── -->
    <section class="ap-expertises">
        <div class="container">
            <div class="ap-section-header">
                <p class="ap-section-eyebrow">Notre pôle d'expertise</p>
                <h2 class="ap-section-title">Maîtrise totale de<br><em>chaque étape</em></h2>
                <p class="ap-section-sub">Une équipe complète et complémentaire pour votre projet immobilier au Portugal.</p>
            </div>

            <div class="ap-exp-grid">
                <div class="ap-exp-item">
                    <div class="ap-exp-icon">
                        <img src="/images/expertises/coaching.png" alt="Coaching" />
                    </div>
                    <div class="ap-exp-name">Coaching Professionnel<br>Certifié ICF</div>
                </div>
                <div class="ap-exp-item">
                    <div class="ap-exp-icon">
                        <img src="/images/expertises/conseil.png" alt="Conseil" />
                    </div>
                    <div class="ap-exp-name">Conseil Stratégique</div>
                </div>
                <div class="ap-exp-item">
                    <div class="ap-exp-icon">
                        <img src="/images/expertises/experience.png" alt="Expérience" />
                    </div>
                    <div class="ap-exp-name">Expérience en immobilier</div>
                </div>
                <div class="ap-exp-item">
                    <div class="ap-exp-icon">
                        <img src="/images/expertises/prospection.png" alt="Prospection" />
                    </div>
                    <div class="ap-exp-name">Prospection</div>
                </div>
                <div class="ap-exp-item">
                    <div class="ap-exp-icon">
                        <img src="/images/expertises/vente.png" alt="Vente" />
                    </div>
                    <div class="ap-exp-name">Vente immobilière</div>
                </div>
                <div class="ap-exp-item">
                    <div class="ap-exp-icon">
                        <img src="/images/expertises/architecture.png" alt="Architecture" />
                    </div>
                    <div class="ap-exp-name">Architecture</div>
                </div>
                <div class="ap-exp-item">
                    <div class="ap-exp-icon">
                        <img src="/images/expertises/construction.png" alt="Construction" />
                    </div>
                    <div class="ap-exp-name">Construction</div>
                </div>
                <div class="ap-exp-item">
                    <div class="ap-exp-icon">
                        <img src="/images/expertises/reseau.png" alt="Réseau" />
                    </div>
                    <div class="ap-exp-name">Réseau local & national</div>
                </div>
                <div class="ap-exp-item">
                    <div class="ap-exp-icon">
                        <img src="/images/expertises/gestion.png" alt="Gestion" />
                    </div>
                    <div class="ap-exp-name">Gestion administrative</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ── CTA ── -->
    <section class="ap-cta">
        <div class="ap-cta-glow"></div>
        <div class="ap-cta-inner">
            <div class="ap-cta-eyebrow">Travaillons ensemble</div>
            <h2 class="ap-cta-title">Votre projet<br><em>commence ici</em></h2>
            <p class="ap-cta-sub">
                Prenez rendez-vous pour un premier échange — nous vous écoutons et définissons ensemble la meilleure stratégie pour votre projet au Portugal.
            </p>
            <a asp-controller="Contact" asp-action="Contact" class="ap-cta-btn">
                Prendre rendez-vous
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
        </div>
    </section>

</div>
