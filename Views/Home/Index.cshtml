@model List<Human_Evolution.Models.Bien>
@{
    ViewData["Title"] = "Human Square – Conseil Immobilier & Investissement au Portugal";
}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Outfit:wght@200;300;400;500&display=swap" rel="stylesheet" />

<style>
    /* ── Reset & Base ── */
    *, *::before, *::after {
        box-sizing: border-box;
    }

    :root {
        --ink: #0e0e0c;
        --cream: #f7f5f0;
        --warm: #ede9e1;
        --gold: #c9a96e;
        --gold-light: #e8d5b0;
        --muted: #7a7870;
        --hint: #b0ae9f;
        --border: rgba(14,14,12,0.1);
    }

    .hs-home {
        font-family: 'Outfit', sans-serif;
        color: var(--ink);
        background: var(--cream);
        overflow-x: hidden;
    }

    /* ── HERO ── */
    .hs-hero {
        position: relative;
        height: 100vh;
        min-height: 640px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        padding-bottom: 80px;
        overflow: hidden;
    }

    .hs-hero-bg {
        position: absolute;
        inset: 0;
        background-image: url('/images/hero-background.jpg');
        background-size: cover;
        background-position: center;
        transform-origin: center;
        animation: heroZoom 18s ease-in-out infinite alternate;
    }

    @@keyframes heroZoom {
        from {
            transform: scale(1);
        }

        to {
            transform: scale(1.06);
        }
    }

    .hs-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( to bottom, rgba(14,14,12,0.25) 0%, rgba(14,14,12,0.1) 40%, rgba(14,14,12,0.6) 100% );
    }

    /* Stats row at top */
    .hs-hero-stats {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 3;
        display: flex;
        justify-content: center;
        gap: 0;
        border-bottom: 0.5px solid rgba(255,255,255,0.15);
        backdrop-filter: blur(8px);
        background: rgba(14,14,12,0.3);
    }

    .hs-stat {
        flex: 1;
        max-width: 200px;
        padding: 20px 24px;
        text-align: center;
        border-right: 0.5px solid rgba(255,255,255,0.12);
    }

        .hs-stat:last-child {
            border-right: none;
        }

    .hs-stat-num {
        font-family: 'Cormorant Garamond', serif;
        font-size: 28px;
        font-weight: 300;
        color: #fff;
        line-height: 1;
        margin-bottom: 4px;
    }

    .hs-stat-label {
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.55);
    }

    /* Hero center content */
    .hs-hero-content {
        position: relative;
        z-index: 3;
        text-align: center;
        max-width: 760px;
        padding: 0 24px;
        animation: heroFadeUp 1.2s cubic-bezier(.22,1,.36,1) both;
    }

    @@keyframes heroFadeUp {
        from {
            opacity: 0;
            transform: translateY(32px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hs-hero-eyebrow {
        font-size: 10px;
        font-weight: 300;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold-light);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

        .hs-hero-eyebrow::before,
        .hs-hero-eyebrow::after {
            content: '';
            display: block;
            width: 40px;
            height: 0.5px;
            background: var(--gold);
            opacity: 0.6;
        }

    .hs-hero-logo {
        height: 72px;
        width: auto;
        margin-bottom: 20px;
        filter: brightness(0) invert(1);
        opacity: 0.95;
    }

    .hs-hero-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(44px, 7vw, 78px);
        font-weight: 300;
        line-height: 1.05;
        color: #fff;
        margin-bottom: 18px;
        letter-spacing: -0.01em;
    }

        .hs-hero-title em {
            font-style: italic;
            color: var(--gold-light);
        }

    .hs-hero-sub {
        font-size: 15px;
        font-weight: 300;
        color: rgba(255,255,255,0.65);
        line-height: 1.7;
        margin-bottom: 36px;
        max-width: 480px;
        margin-left: auto;
        margin-right: auto;
    }

    .hs-hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        font-weight: 400;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #fff;
        text-decoration: none;
        border: 0.5px solid rgba(255,255,255,0.4);
        padding: 14px 32px;
        border-radius: 2px;
        transition: background .2s, border-color .2s;
        backdrop-filter: blur(4px);
        background: rgba(201,169,110,0.15);
    }

        .hs-hero-cta:hover {
            background: var(--gold);
            border-color: var(--gold);
            color: var(--ink);
        }

    /* Scroll indicator */
    .hs-scroll-hint {
        position: absolute;
        bottom: 28px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 3;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        opacity: 0.5;
        animation: scrollBob 2s ease-in-out infinite;
    }

    @@keyframes scrollBob {
        0%, 100% {
            transform: translateX(-50%) translateY(0);
        }

        50% {
            transform: translateX(-50%) translateY(6px);
        }
    }

    .hs-scroll-hint span {
        font-size: 9px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #fff;
        font-weight: 300;
    }

    .hs-scroll-arrow {
        width: 16px;
        height: 16px;
        border-right: 0.5px solid #fff;
        border-bottom: 0.5px solid #fff;
        transform: rotate(45deg);
    }

    /* ── BIENS SECTION ── */
    .hs-biens {
        background: var(--cream);
        padding: 88px 0 80px;
    }

    .hs-biens-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 48px;
        gap: 24px;
    }

    .hs-section-eyebrow {
        font-size: 10px;
        font-weight: 400;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 10px;
    }

    .hs-section-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(32px, 4vw, 48px);
        font-weight: 300;
        line-height: 1.08;
        color: var(--ink);
        margin: 0;
    }

        .hs-section-title em {
            font-style: italic;
            color: var(--muted);
        }

    .hs-voir-tout {
        font-size: 12px;
        font-weight: 400;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        padding-bottom: 2px;
        border-bottom: 0.5px solid var(--ink);
        transition: color .15s, border-color .15s;
        flex-shrink: 0;
    }

        .hs-voir-tout:hover {
            color: var(--gold);
            border-color: var(--gold);
        }

    /* Biens grid */
    .hs-biens-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .hs-bien-card {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 0.5px solid var(--border);
        transition: transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s;
        overflow: hidden;
    }

        .hs-bien-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 48px rgba(14,14,12,0.1);
            color: inherit;
        }

    .hs-bien-media {
        position: relative;
        height: 240px;
        overflow: hidden;
        background: var(--warm);
    }

        .hs-bien-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .5s cubic-bezier(.22,1,.36,1);
        }

    .hs-bien-card:hover .hs-bien-media img {
        transform: scale(1.05);
    }

    .hs-bien-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hs-bien-badge {
        position: absolute;
        top: 16px;
        left: 16px;
        font-size: 9px;
        font-weight: 400;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 1px;
    }

    .badge-apt {
        background: rgba(230,241,251,.95);
        color: #0C447C;
    }

    .badge-villa {
        background: rgba(234,243,222,.95);
        color: #27500A;
    }

    .badge-ter {
        background: rgba(250,238,218,.95);
        color: #633806;
    }

    .badge-com {
        background: rgba(251,234,240,.95);
        color: #72243E;
    }

    .hs-bien-body {
        padding: 22px 24px 24px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
    }

    .hs-bien-loc {
        font-size: 10px;
        font-weight: 400;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--hint);
    }

    .hs-bien-titre {
        font-family: 'Cormorant Garamond', serif;
        font-size: 20px;
        font-weight: 400;
        line-height: 1.2;
        color: var(--ink);
    }

    .hs-bien-prix {
        font-family: 'Cormorant Garamond', serif;
        font-size: 22px;
        font-weight: 300;
        color: var(--ink);
        margin-top: 4px;
    }

        .hs-bien-prix small {
            font-family: 'Outfit', sans-serif;
            font-size: 10px;
            font-weight: 300;
            color: var(--hint);
            letter-spacing: 0.06em;
        }

    .hs-bien-specs {
        display: flex;
        gap: 16px;
        padding-top: 12px;
        border-top: 0.5px solid var(--border);
        margin-top: 4px;
    }

    .hs-bien-spec {
        font-size: 11px;
        font-weight: 300;
        color: var(--muted);
    }

    .hs-bien-link {
        font-size: 10px;
        font-weight: 400;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gold);
        margin-top: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: gap .2s;
    }

    .hs-bien-card:hover .hs-bien-link {
        gap: 10px;
    }

    .hs-empty-biens {
        grid-column: 1/-1;
        padding: 64px 24px;
        text-align: center;
        background: var(--warm);
        border: 0.5px solid var(--border);
    }

        .hs-empty-biens p {
            font-size: 14px;
            color: var(--muted);
            margin-bottom: 20px;
        }

    /* ── CTA SECTION ── */
    .hs-cta-section {
        position: relative;
        background: var(--ink);
        padding: 96px 0;
        overflow: hidden;
    }

    .hs-cta-bg-pattern {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(ellipse 60% 80% at 80% 50%, rgba(201,169,110,0.08) 0%, transparent 70%), radial-gradient(ellipse 40% 60% at 20% 50%, rgba(201,169,110,0.05) 0%, transparent 70%);
    }

    .hs-cta-inner {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 600px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .hs-cta-eyebrow {
        font-size: 10px;
        font-weight: 300;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

        .hs-cta-eyebrow::before,
        .hs-cta-eyebrow::after {
            content: '';
            display: block;
            width: 32px;
            height: 0.5px;
            background: var(--gold);
            opacity: 0.5;
        }

    .hs-cta-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(32px, 4vw, 50px);
        font-weight: 300;
        line-height: 1.1;
        color: #fff;
        margin-bottom: 16px;
    }

        .hs-cta-title em {
            font-style: italic;
            color: var(--gold-light);
        }

    .hs-cta-sub {
        font-size: 14px;
        font-weight: 300;
        color: rgba(255,255,255,0.5);
        line-height: 1.7;
        margin-bottom: 40px;
    }

    .hs-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        background: var(--gold);
        padding: 16px 40px;
        border-radius: 2px;
        transition: background .2s, transform .2s;
    }

        .hs-cta-btn:hover {
            background: var(--gold-light);
            color: var(--ink);
            transform: translateY(-2px);
        }

    /* ── Responsive ── */
    @@media (max-width: 992px) {
        .hs-biens-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .hs-hero-stats {
            display: none;
        }
    }

    @@media (max-width: 640px) {
        .hs-biens-grid {
            grid-template-columns: 1fr;
        }

        .hs-biens-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .hs-biens {
            padding: 56px 0 48px;
        }
    }
</style>

<div class="hs-home">

    <!-- ── HERO ── -->
    <section class="hs-hero">
        <div class="hs-hero-bg"></div>
        <div class="hs-hero-overlay"></div>

        <!-- Stats bar -->
        <div class="hs-hero-stats">
            <div class="hs-stat">
                <div class="hs-stat-num">Depuis <span class="counter" data-target="2017">2017</span></div>
                <div class="hs-stat-label">Année de lancement</div>
            </div>
            <div class="hs-stat">
                <div class="hs-stat-num"><span class="counter" data-target="784">784</span></div>
                <div class="hs-stat-label">Sessions de coaching</div>
            </div>
            <div class="hs-stat">
                <div class="hs-stat-num"><span class="counter" data-target="52">52</span></div>
                <div class="hs-stat-label">Projets accompagnés</div>
            </div>
            <div class="hs-stat">
                <div class="hs-stat-num"><span class="counter" data-target="191">191</span></div>
                <div class="hs-stat-label">Formations réalisées</div>
            </div>
        </div>

        <!-- Main content -->
        <div class="hs-hero-content">
            <img src="/images/Logo_HS_blanc.png" alt="Human Square" class="hs-hero-logo" />
            <div class="hs-hero-eyebrow">Conseil Immobilier · Portugal</div>
            <h1 class="hs-hero-title">
                L'accompagnement<br><em>sur mesure</em> au Portugal
            </h1>
            <p class="hs-hero-sub">
                Stratégie, acquisition et suivi personnalisé pour votre projet immobilier — de l'idée à la clé en main.
            </p>
            <a asp-controller="Contact" asp-action="Contact" class="hs-hero-cta">
                Prendre rendez-vous
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
        </div>

        <!-- Scroll hint -->
        <div class="hs-scroll-hint">
            <span>Découvrir</span>
            <div class="hs-scroll-arrow"></div>
        </div>
    </section>

    <!-- ── BIENS RÉCENTS ── -->
    <section class="hs-biens">
        <div class="container">
            <div class="hs-biens-header">
                <div>
                    <p class="hs-section-eyebrow">Catalogue immobilier · Portugal</p>
                    <h2 class="hs-section-title">Biens <em>récemment publiés</em></h2>
                </div>
                <a href="/Biens" class="hs-voir-tout d-none d-md-flex">
                    Voir tout le catalogue
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="hs-biens-grid">
                    <div class="hs-empty-biens">
                        <p>Aucun bien publié pour le moment.</p>
                        <a href="/Biens" class="hs-voir-tout" style="display:inline-flex;margin:0 auto">Voir le catalogue →</a>
                    </div>
                </div>
            }
            else
            {
                <div class="hs-biens-grid">
                    @foreach (var b in Model)
                    {
                        var badgeClass = b.Type switch
                        {
                            "Appartement" => "badge-apt",
                            "Maison" => "badge-villa",
                            "Terrain" => "badge-ter",
                            "Commercial" => "badge-com",
                            _ => ""
                        };
                        var bgColor = b.Type switch
                        {
                            "Appartement" => "#B5D4F430",
                            "Maison" => "#C0DD9730",
                            "Terrain" => "#FAC77530",
                            "Commercial" => "#F4C0D130",
                            _ => "#ede9e1"
                        };
                        var darkColor = b.Type switch
                        {
                            "Appartement" => "#0C447C",
                            "Maison" => "#27500A",
                            "Terrain" => "#633806",
                            "Commercial" => "#72243E",
                            _ => "#7a7870"
                        };

                        <a class="hs-bien-card" href="/Biens">
                            <div class="hs-bien-media">
                                @if (!string.IsNullOrEmpty(b.ImagePrincipale))
                                {
                                    <img src="@b.ImagePrincipale" alt="@b.Titre" loading="lazy" />
                                }
                                else
                                {
                                    <div class="hs-bien-placeholder" style="background:@bgColor">
                                        <span style="font-family:'Cormorant Garamond',serif;font-size:11px;letter-spacing:4px;color:@darkColor;opacity:.4">@b.Reference</span>
                                    </div>
                                }
                                <span class="hs-bien-badge @badgeClass">@b.Type</span>
                            </div>
                            <div class="hs-bien-body">
                                <p class="hs-bien-loc">📍 @b.Quartier · @b.Ville</p>
                                <h3 class="hs-bien-titre">@b.Titre</h3>
                                <div class="hs-bien-prix">
                                    @b.Prix.ToString("N0") €
                                    <small>prix de vente</small>
                                </div>
                                <div class="hs-bien-specs">
                                    @if (b.Surface.HasValue)
                                    {
                                        <span class="hs-bien-spec">@b.Surface m²</span>
                                    }
                                    @if (b.NbPieces.HasValue)
                                    {
                                        <span class="hs-bien-spec">@b.NbPieces pièces</span>
                                    }
                                    @if (b.NbSdb.HasValue)
                                    {
                                        <span class="hs-bien-spec">@b.NbSdb sdb</span>
                                    }
                                </div>
                                <div class="hs-bien-link">
                                    Voir le bien
                                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
                                        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>
                            </div>
                        </a>
                    }
                </div>

                <div class="text-center mt-4 d-md-none">
                    <a href="/Biens" class="hs-voir-tout" style="display:inline-flex">Voir tout le catalogue →</a>
                </div>
            }
        </div>
    </section>

    <!-- ── CTA ── -->
    <section class="hs-cta-section">
        <div class="hs-cta-bg-pattern"></div>
        <div class="hs-cta-inner">
            <div class="hs-cta-eyebrow">Human Square · Portugal</div>
            <h2 class="hs-cta-title">Prêt à lancer<br><em>votre projet ?</em></h2>
            <p class="hs-cta-sub">
                Réservez un appel découverte et voyons ensemble comment Human Square peut vous accompagner vers votre objectif immobilier.
            </p>
            <a asp-controller="Contact" asp-action="Contact" class="hs-cta-btn">
                Contactez-nous
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
        </div>
    </section>

</div>
