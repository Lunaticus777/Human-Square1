
@model IEnumerable<Human_Evolution.Models.Project>
@{
    ViewData["Title"] = "Projets Immobiliers au Portugal – Human Square";
}
<div class="container my-5">
    <h1 class="fw-bold mb-4">
        Projets immobiliers accompagnés par Human Square au Portugal
    </h1>
    <p class="text-muted mb-5">
        Découvrez une sélection de projets immobiliers accompagnés par Human Square :
        investissement immobilier, rénovation, construction et développement de biens au Portugal.
    </p>
    <!-- Filtres dynamiques (simple exemple) -->
    <div class="row mb-4">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Recherche par titre...">
        </div>
        <div class="col-md-4">
            <select class="form-select">
                <option selected>Filtrer par état</option>
                <option>Idée</option>
                <option>Étude</option>
                <option>Permis</option>
                <option>Chantier</option>
                <option>Livré</option>
            </select>
        </div>
    </div>

    <!-- Cartes projets -->
    <div class="row">
        @foreach (var project in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden text-center">
                    <img src="@project.ImageUrl" class="card-img-top" alt="Projet immobilier au Portugal - @project.Title" />
                    <div class="card-body">
                        <h5 class="card-title fw-bold mb-3">@project.Title</h5>
                        <p class="text-muted small">
                            Projet immobilier accompagné par Human Square au Portugal.
                        </p>
                        <button class="btn btn-outline-dark rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#@project.ModalId">
                            Plus de détails
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
