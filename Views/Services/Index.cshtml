@{
    ViewData["Title"] = "Prestations – Human Square";
    ViewData["Description"] = "Coaching ICF, consulting stratégique, audit immobilier et formations au Portugal. Human Square accompagne vos projets avec rigueur et vision.";
}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet" />

<style>
    :root {
        --ink: #0c0c0a;
        --cream: #f5f3ee;
        --warm: #ece8df;
        --gold: #b8935a;
        --gold2: #d4b483;
        --muted: #78766e;
        --hint: #aeac9f;
        --border: rgba(12,12,10,0.09);
    }

    .sv {
        font-family: 'Cormorant Garamond', Georgia, serif;
        background: var(--cream);
        color: var(--ink);
        overflow-x: hidden;
    }

    /* ── HERO SPLIT ── */
    .sv-hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 90vh;
        position: relative;
    }

    .sv-hero-left {
        background: var(--ink);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 80px 64px;
        position: relative;
        overflow: hidden;
    }

        /* Grille décorative géométrique */
        .sv-hero-left::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: linear-gradient(rgba(184,147,90,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(184,147,90,0.06) 1px, transparent 1px);
            background-size: 48px 48px;
            pointer-events: none;
        }

        .sv-hero-left::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 40%;
            background: linear-gradient(to top, rgba(12,12,10,1) 0%, transparent 100%);
            pointer-events: none;
        }

    .sv-hero-counter {
        position: absolute;
        top: 48px;
        left: 64px;
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 300;
        letter-spacing: 0.2em;
        color: rgba(255,255,255,0.2);
        z-index: 2;
    }

    .sv-hero-left-content {
        position: relative;
        z-index: 2;
    }

    .sv-hero-pretitle {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 300;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

        .sv-hero-pretitle::before {
            content: '';
            display: block;
            width: 24px;
            height: 1px;
            background: var(--gold);
        }

    .sv-hero-h1 {
        font-size: clamp(48px, 5vw, 80px);
        font-weight: 300;
        line-height: 0.95;
        color: #fff;
        margin-bottom: 32px;
        letter-spacing: -0.02em;
    }

        .sv-hero-h1 em {
            font-style: italic;
            color: var(--gold2);
            display: block;
        }

    .sv-hero-desc {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
        font-weight: 300;
        line-height: 1.7;
        color: rgba(255,255,255,0.38);
        max-width: 340px;
        letter-spacing: 0.03em;
    }

    /* Côté droit : index des services */
    .sv-hero-right {
        background: var(--warm);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 80px 64px;
        border-left: 0.5px solid var(--border);
    }

    .sv-hero-index-title {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--hint);
        margin-bottom: 40px;
    }

    .sv-hero-service-item {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 20px 0;
        border-bottom: 0.5px solid var(--border);
        cursor: pointer;
        transition: all .2s;
        text-decoration: none;
        color: inherit;
    }

        .sv-hero-service-item:first-of-type {
            border-top: 0.5px solid var(--border);
        }

        .sv-hero-service-item:hover {
            padding-left: 12px;
        }

    .sv-hero-service-num {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 300;
        color: var(--gold);
        letter-spacing: 0.1em;
        flex-shrink: 0;
        width: 28px;
    }

    .sv-hero-service-name {
        font-size: 22px;
        font-weight: 300;
        color: var(--ink);
        flex: 1;
        line-height: 1;
    }

    .sv-hero-service-arrow {
        opacity: 0;
        transition: opacity .2s;
        color: var(--gold);
        font-size: 18px;
    }

    .sv-hero-service-item:hover .sv-hero-service-arrow {
        opacity: 1;
    }

    .sv-hero-service-item:hover .sv-hero-service-name {
        color: var(--gold);
    }

    /* ── NAV BANDE ── */
    .sv-band {
        background: var(--ink);
        position: sticky;
        top: 72px;
        z-index: 90;
        display: flex;
        align-items: stretch;
        height: 52px;
        border-bottom: 0.5px solid rgba(255,255,255,0.06);
    }

    .sv-band-tab {
        flex: 1;
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 300;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.3);
        background: none;
        border: none;
        border-right: 0.5px solid rgba(255,255,255,0.06);
        cursor: pointer;
        transition: all .2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        position: relative;
    }

        .sv-band-tab::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--gold);
            transform: scaleX(0);
            transition: transform .2s;
        }

        .sv-band-tab.active {
            color: rgba(255,255,255,0.9);
        }

            .sv-band-tab.active::after {
                transform: scaleX(1);
            }

        .sv-band-tab:hover {
            color: rgba(255,255,255,0.6);
        }

        .sv-band-tab:last-child {
            border-right: none;
        }

    .sv-band-num {
        font-size: 8px;
        color: var(--gold);
        opacity: 0.7;
    }

    /* ── SECTIONS CONTENU ── */
    .sv-content {
        padding: 0;
    }

    .sv-section {
        display: none;
    }

        .sv-section.active {
            display: block;
        }

    /* Titre de section */
    .sv-section-banner {
        background: var(--cream);
        padding: 72px 80px 56px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 64px;
        align-items: end;
        border-bottom: 0.5px solid var(--border);
    }

    .sv-section-label {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 16px;
    }

    .sv-section-h2 {
        font-size: clamp(36px, 4vw, 58px);
        font-weight: 300;
        line-height: 0.96;
        color: var(--ink);
        letter-spacing: -0.02em;
    }

        .sv-section-h2 em {
            font-style: italic;
            color: var(--muted);
            display: block;
        }

    .sv-section-intro {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
        font-weight: 300;
        line-height: 1.75;
        color: var(--muted);
        letter-spacing: 0.03em;
        padding-top: 8px;
    }

    /* ── GRILLE SERVICES ── */
    .sv-cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        background: var(--border);
        border-bottom: 0.5px solid var(--border);
    }

    .sv-card {
        background: var(--cream);
        padding: 40px 36px;
        display: flex;
        flex-direction: column;
        gap: 0;
        border-right: 0.5px solid var(--border);
        position: relative;
        overflow: hidden;
        transition: background .25s;
        cursor: default;
    }

        .sv-card:last-child {
            border-right: none;
        }

        .sv-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--gold);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .3s;
        }

        .sv-card:hover::before {
            transform: scaleX(1);
        }

        .sv-card:hover {
            background: #fff;
        }

    .sv-card-num {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        color: var(--gold);
        letter-spacing: 0.1em;
        margin-bottom: 28px;
        opacity: 0.7;
    }

    .sv-card-title {
        font-size: 22px;
        font-weight: 300;
        color: var(--ink);
        line-height: 1.15;
        margin-bottom: 16px;
        letter-spacing: -0.01em;
    }

    .sv-card-text {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        font-weight: 300;
        line-height: 1.7;
        color: var(--muted);
        letter-spacing: 0.02em;
        flex: 1;
        margin-bottom: 28px;
    }

    .sv-card-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
        background: none;
        border: 0.5px solid rgba(12,12,10,0.2);
        padding: 10px 18px;
        cursor: pointer;
        transition: all .2s;
        align-self: flex-start;
    }

        .sv-card-btn:hover {
            background: var(--ink);
            color: var(--cream);
            border-color: var(--ink);
        }

    /* ── BLOC PROFONDEUR (ICF, etc.) ── */
    .sv-depth {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 420px;
    }

    .sv-depth-left {
        background: var(--ink);
        padding: 64px 72px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .sv-depth-left::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(184,147,90,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(184,147,90,0.04) 1px, transparent 1px);
            background-size: 40px 40px;
        }

    .sv-depth-left-content {
        position: relative;
        z-index: 2;
    }

    .sv-depth-title {
        font-size: 36px;
        font-weight: 300;
        line-height: 1.1;
        color: #fff;
        margin-bottom: 32px;
        letter-spacing: -0.01em;
    }

        .sv-depth-title em {
            font-style: italic;
            color: var(--gold2);
        }

    .sv-depth-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

        .sv-depth-list li {
            font-family: 'DM Mono', monospace;
            font-size: 11px;
            font-weight: 300;
            color: rgba(255,255,255,0.4);
            letter-spacing: 0.04em;
            padding-left: 18px;
            position: relative;
        }

            .sv-depth-list li::before {
                content: '→';
                position: absolute;
                left: 0;
                color: var(--gold);
                opacity: 0.7;
            }

    .sv-depth-right {
        background: var(--warm);
        padding: 64px 72px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 32px;
        border-left: 0.5px solid var(--border);
    }

    .sv-depth-quote {
        font-size: 26px;
        font-weight: 300;
        font-style: italic;
        line-height: 1.3;
        color: var(--ink);
        letter-spacing: -0.01em;
        padding-bottom: 28px;
        border-bottom: 0.5px solid var(--border);
    }

        .sv-depth-quote em {
            color: var(--gold);
        }

    .sv-depth-attrs {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .sv-depth-attr {
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

    .sv-depth-attr-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--gold);
        flex-shrink: 0;
        margin-top: 6px;
    }

    .sv-depth-attr-text {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        font-weight: 300;
        color: var(--muted);
        line-height: 1.6;
        letter-spacing: 0.03em;
    }

    /* ── CTA BANDE FINALE ── */
    .sv-final {
        background: var(--ink);
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 48px;
        padding: 56px 80px;
    }

    .sv-final-text {
        font-size: 32px;
        font-weight: 300;
        color: #fff;
        line-height: 1.15;
        letter-spacing: -0.01em;
    }

        .sv-final-text em {
            font-style: italic;
            color: var(--gold2);
        }

    .sv-final-cta {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        font-weight: 300;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        background: var(--gold);
        padding: 18px 36px;
        transition: background .2s, transform .2s;
        white-space: nowrap;
    }

        .sv-final-cta:hover {
            background: var(--gold2);
            color: var(--ink);
            transform: translateY(-2px);
        }

    /* ── MODALES ── */
    .sv-modal .modal-content {
        border: none;
        border-radius: 0;
        background: var(--cream);
    }

    .sv-modal .modal-header {
        background: var(--ink);
        border: none;
        padding: 28px 40px;
        display: flex;
        align-items: flex-end;
        gap: 20px;
    }

    .sv-modal .modal-title {
        font-size: 28px;
        font-weight: 300;
        color: #fff;
        letter-spacing: -0.01em;
        line-height: 1;
    }

    .sv-modal-pretitle {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 300;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 8px;
    }

    .sv-modal .modal-body {
        padding: 0;
        background: var(--cream);
    }

    .sv-modal-intro {
        padding: 40px 40px 32px;
        border-bottom: 0.5px solid var(--border);
    }

    .sv-modal-intro-text {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
        font-weight: 300;
        line-height: 1.75;
        color: var(--muted);
        letter-spacing: 0.03em;
        max-width: 480px;
    }

    .sv-modal-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0;
        background: var(--border);
    }

    .sv-modal-item {
        background: var(--cream);
        padding: 28px 32px;
        border-right: 0.5px solid var(--border);
        border-bottom: 0.5px solid var(--border);
    }

    .sv-modal-item-num {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        color: var(--gold);
        letter-spacing: 0.1em;
        margin-bottom: 10px;
        opacity: 0.7;
    }

    .sv-modal-item-title {
        font-size: 18px;
        font-weight: 300;
        color: var(--ink);
        margin-bottom: 8px;
    }

    .sv-modal-item-text {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        font-weight: 300;
        color: var(--muted);
        line-height: 1.65;
        letter-spacing: 0.02em;
    }

    .sv-modal-note {
        padding: 24px 40px;
        background: var(--warm);
        border-top: 0.5px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .sv-modal-note-text {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        font-weight: 300;
        color: var(--gold);
        letter-spacing: 0.06em;
        font-style: italic;
    }

    .sv-modal .modal-footer {
        background: var(--cream);
        border-top: 0.5px solid var(--border);
        padding: 16px 40px;
        justify-content: flex-end;
    }

    /* ── Responsive ── */
    @@media (max-width: 1100px) {
        .sv-cards {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 900px) {
        .sv-hero {
            grid-template-columns: 1fr;
        }

        .sv-hero-right {
            display: none;
        }

        .sv-hero-left {
            min-height: 60vh;
            padding: 80px 32px 48px;
        }

        .sv-section-banner {
            grid-template-columns: 1fr;
            padding: 48px 32px;
            gap: 24px;
        }

        .sv-depth {
            grid-template-columns: 1fr;
        }

        .sv-final {
            grid-template-columns: 1fr;
            padding: 48px 32px;
            gap: 28px;
        }

        .sv-cards {
            grid-template-columns: 1fr;
        }

        .sv-modal-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .sv-band {
            overflow-x: auto;
        }

        .sv-band-tab {
            min-width: 120px;
            font-size: 8px;
        }

        .sv-hero-left {
            padding: 64px 24px 40px;
        }

        .sv-depth-left, .sv-depth-right {
            padding: 40px 28px;
        }
    }
</style>

<div class="sv">

    <!-- ══ HERO SPLIT ══ -->
    <section class="sv-hero">
        <div class="sv-hero-left">
            <span class="sv-hero-counter">HS / PRESTATIONS / 2026</span>
            <div class="sv-hero-left-content">
                <p class="sv-hero-pretitle" data-i18n="services_hero_pretitle">Human Square · Portugal</p>
                <h1 class="sv-hero-h1" data-i18n="services_hero_h1" data-i18n-html>
                    Nos<br>
                    <em>prestations</em>
                </h1>
                <p class="sv-hero-desc" data-i18n="services_hero_desc">
                    Coaching certifié ICF, consulting stratégique, audit et formations — pour investisseurs, dirigeants et entrepreneurs au Portugal.
                </p>
            </div>
        </div>
        <div class="sv-hero-right">
            <p class="sv-hero-index-title" data-i18n="services_index_title">Index des prestations</p>
            <a class="sv-hero-service-item" onclick="activateSection('coaching'); return false;" href="#">
                <span class="sv-hero-service-num">01</span>
                <span class="sv-hero-service-name" data-i18n="services_idx1">Coaching professionnel</span>
                <span class="sv-hero-service-arrow">→</span>
            </a>
            <a class="sv-hero-service-item" onclick="activateSection('consulting'); return false;" href="#">
                <span class="sv-hero-service-num">02</span>
                <span class="sv-hero-service-name" data-i18n="services_idx2">Consulting stratégique</span>
                <span class="sv-hero-service-arrow">→</span>
            </a>
            <a class="sv-hero-service-item" onclick="activateSection('audit'); return false;" href="#">
                <span class="sv-hero-service-num">03</span>
                <span class="sv-hero-service-name" data-i18n="services_idx3">Audit & optimisation</span>
                <span class="sv-hero-service-arrow">→</span>
            </a>
            <a class="sv-hero-service-item" onclick="activateSection('formation'); return false;" href="#">
                <span class="sv-hero-service-num">04</span>
                <span class="sv-hero-service-name" data-i18n="services_idx4">Formations</span>
                <span class="sv-hero-service-arrow">→</span>
            </a>
        </div>
    </section>

    <!-- ══ BANDE NAV ══ -->
    <div class="sv-band">
        <button class="sv-band-tab active" onclick="activateSection('coaching')" id="tab-coaching">
            <span class="sv-band-num">01</span> <span data-i18n="services_tab1">Coaching</span>
        </button>
        <button class="sv-band-tab" onclick="activateSection('consulting')" id="tab-consulting">
            <span class="sv-band-num">02</span> <span data-i18n="services_tab2">Consulting</span>
        </button>
        <button class="sv-band-tab" onclick="activateSection('audit')" id="tab-audit">
            <span class="sv-band-num">03</span> <span data-i18n="services_tab3">Audit</span>
        </button>
        <button class="sv-band-tab" onclick="activateSection('formation')" id="tab-formation">
            <span class="sv-band-num">04</span> <span data-i18n="services_tab4">Formations</span>
        </button>
    </div>

    <!-- ══ CONTENU ══ -->
    <div class="sv-content">

        <!-- ── COACHING ── -->
        <div id="sv-coaching" class="sv-section active">
            <div class="sv-section-banner">
                <div>
                    <p class="sv-section-label" data-i18n="services_coaching_label">01 — Coaching Professionnel</p>
                    <h2 class="sv-section-h2" data-i18n="services_coaching_h2" data-i18n-html>
                        Transformation<br>
                        <em>& alignement</em>
                    </h2>
                </div>
                <p class="sv-section-intro" data-i18n="services_coaching_intro">Une démarche de clarification profonde, portée par un coach certifié ICF — pour investisseurs, dirigeants et entrepreneurs engagés dans un parcours exigeant.</p>
            </div>

            <div class="sv-cards">
                <div class="sv-card">
                    <p class="sv-card-num">01.1</p>
                    <h3 class="sv-card-title" data-i18n="services_coaching_c1_title" data-i18n-html>Coaching<br>Immobilier</h3>
                    <p class="sv-card-text" data-i18n="services_coaching_c1_text">Structuration de votre stratégie d'investissement, vision à long terme, priorisation des opportunités et gestion des risques.</p>
