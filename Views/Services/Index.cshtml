<script>
    function activateSection(id) {
        document.querySelectorAll('.sv-section').forEach(s => s.classList.remove('active'));
        document.getElementById('sv-' + id).classList.add('active');
        document.querySelectorAll('.sv-band-tab').forEach(t => t.classList.remove('active'));
        document.getElementById('tab-' + id).classList.add('active');
        const band = document.querySelector('.sv-band');
        if (band) window.scrollTo({ top: band.offsetTop - 72, behavior: 'smooth' });
    }
</script>
