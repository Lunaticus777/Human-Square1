@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "Human Square accompagne les projets immobiliers et investissements au Portugal : stratégie, acquisition, réseau local et accompagnement sur mesure.")" />
    <meta property="og:title" content="@ViewData["Title"] | Human Square" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Human Square accompagne les projets immobiliers et investissements au Portugal.")" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://human-square.com/images/Human_Square_Logo.png" />
    <meta property="og:url" content="@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="_ek8itCYCOZJ3HXerrZP7iIghOo42_5p1CDo7kecxPI" />
    <link rel="canonical" href="@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path" />
    <title>@ViewData["Title"] | Human Square</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Cacher le widget Google Translate sauf pour les navigateurs non-Chrome */
        #google_translate_element,
        .goog-te-banner-frame.skiptranslate,
        .goog-te-gadget,
        iframe.goog-te-banner-frame,
        body > .skiptranslate {
            display: none !important;
        }

        body {
            top: 0px !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="/images/Human_Square_Logo.png?v=2"
                         alt="Human Square"
                         class="me-2 nav-logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">À propos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Biens">Acheter un bien immobilier</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Services" asp-action="Index">Prestations</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Projects">Projets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Contact">Contact</a>
                        </li>

                        <!-- Menu Langue visible pour les navigateurs non-Chrome -->
                        <li class="nav-item dropdown" id="langDropdownContainer" style="display: none;">
                            <a class="nav-link dropdown-toggle text-uppercase" href="#" id="langDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Langue
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="langDropdown">
                                <li><button class="dropdown-item" onclick="changeLanguage('fr')">🇫🇷 Français</button></li>
                                <li><button class="dropdown-item" onclick="changeLanguage('pt')">🇵🇹 Português</button></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <style>
            body {
                padding-top: 110px;
            }
        </style>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6 mb-3 mb-md-0">
                    <h5>Human Square</h5>
                    <p class="mb-0">@Localizer["Footer_Company"]</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a href="/Home/Privacy" class="text-light me-3">@Localizer["Footer_Legal"]</a>
                    <a asp-controller="Contact" asp-action="Contact" class="btn btn-outline-light btn-sm">@Localizer["Contact"]</a>
                </div>
            </div>
            <hr class="border-light my-3" />
            <p class="text-center mb-0">&copy; 2025 Human Square. @Localizer["Footer_Claim"]</p>
        </div>
    </footer>

    <div id="google_translate_element" style="display: none;"></div>

    <!-- JS POUR GESTION INTELLIGENTE DE GOOGLE TRANSLATE -->
    <script>
        const isChrome = /Chrome/.test(navigator.userAgent) && /Google Inc/.test(navigator.vendor);

        if (!isChrome) {
            // Charger le script Google Translate
            const gtScript = document.createElement('script');
            gtScript.src = "//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit";
            document.head.appendChild(gtScript);

            // Afficher le bouton langue custom
            document.addEventListener("DOMContentLoaded", function () {
                const dropdown = document.getElementById("langDropdownContainer");
                if (dropdown) dropdown.style.display = "block";
            });
        }

        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'fr',
                includedLanguages: 'fr,pt',
                layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
                autoDisplay: false
            }, 'google_translate_element');
        }

        function changeLanguage(lang) {
            const cookieValue = `/fr/${lang}`;
            document.cookie = `googtrans=${cookieValue};path=/;domain=.human-square.com`;
            window.location.reload();
        }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const counters = document.querySelectorAll('.counter');

            if (!counters.length) return;

            const startCounter = (entry) => {
                const el = entry.target;
                const target = +el.getAttribute('data-target');
                const duration = 1500;
                const stepTime = 20;
                const steps = Math.ceil(duration / stepTime);

                let count = 0;
                const increment = target / steps;

                el.textContent = '0';

                const interval = setInterval(() => {

                    count += increment;

                    if (count >= target) {
                        el.textContent = target;
                        clearInterval(interval);
                    } else {
                        el.textContent = Math.ceil(count);
                    }

                }, stepTime);
            };

            const observer = new IntersectionObserver((entries, observer) => {

                entries.forEach(entry => {

                    if (entry.isIntersecting) {
                        startCounter(entry);
                        observer.unobserve(entry.target);
                    }

                });

            }, { threshold: 0.5 });

            counters.forEach(counter => {
                observer.observe(counter);
            });

        });
    </script>
</body>
</html>
